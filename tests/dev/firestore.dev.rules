rules_version = '2';

// SOLO per `npm run dev:firebase`: regole aperte perché l'emulatore è locale e senza account.
// Non vanno mai pubblicate su un progetto Firebase vero.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
