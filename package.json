{
  "name": "blesscommander",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "web",
    "data-actions",
    "tests"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:lan": "npm run dev:lan -w web",
    "dev:fake-github": "node tests/dev/fake-github-dev.js",
    "preview": "npm run preview -w web",
    "build": "npm run build -w web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:test": "node tests/seed/seed.js",
    "recalc": "node data-actions/src/cli.js",
    "build:data-repo": "node data-actions/src/build-data-repo.js",
    "build:data-repo:live": "node data-actions/src/build-data-repo.js data-actions/dist/data-repo-live --live",
    "build:data-repo:test": "node data-actions/src/build-data-repo.js data-actions/dist/data-repo-test --test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:visual-review": "playwright test visual-review --project=iphone --project=desktop-chrome",
    "live:diagnose": "node tests/live/diagnose-deck.mjs",
    "test:live": "playwright test -c playwright.live.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
