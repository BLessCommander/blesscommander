rules_version = '2';

// Provvisorio (E-02a): nega tutto. Le regole vere arrivano con E-02b (SPEC §6.10).
// Finché non ci sono, nessuno deve pubblicare questo progetto: i test usano l'emulatore
// con le regole disattivate.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
